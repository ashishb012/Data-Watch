<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DataWatch"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"/>
            
        <Button
            android:id="@+id/btn_hide_notif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hide Notif"
            android:textSize="12sp"
            android:minHeight="36dp"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="8dp"/>
            
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X"
            android:textSize="12sp"
            android:minHeight="36dp"
            android:minWidth="36dp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">
        
        <TextView
            android:id="@+id/tv_rx_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↓ 0 B/s"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"/>
            
        <TextView
            android:id="@+id/tv_tx_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↑ 0 B/s"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"/>
    </LinearLayout>
    
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider"
        android:layout_marginVertical="6dp"/>
        
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        
        <TextView
            android:id="@+id/tv_mobile_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📱 Mobile: 0 B"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"/>
            
        <TextView
            android:id="@+id/tv_wifi_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📶 WiFi: 0 B"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
